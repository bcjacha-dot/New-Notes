{
  "entities": {
    "Note": {
      "title": "Note",
      "description": "A personal note created by a user.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the note."
        },
        "content": {
          "type": "string",
          "description": "Markdown content of the note."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this note."
        },
        "tags": {
          "type": "array",
          "description": "List of tags associated with the note."
        },
        "category": {
          "type": "string",
          "description": "AI-generated category for the note."
        },
        "summary": {
          "type": "string",
          "description": "AI-generated summary of the note."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the note was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the note was last updated."
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the note is pinned to the top."
        }
      },
      "required": ["title", "content", "userId", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Private profile data for a user.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "notes": {
      "schema": "Note",
      "description": "Collection of user notes."
    },
    "users/{userId}/private/profile": {
      "schema": "UserProfile",
      "description": "Private profile for each user."
    }
  }
}
